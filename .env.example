# VPN-PacketSense v2 — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Primary LLM: Ollama (phi4-mini) ─────────────────────────
# Ollama is the default primary LLM provider for the AI agent.
# It runs locally or over an SSH tunnel from a remote laptop / GPU machine.
#
# Remote SSH Tunnel Workflow:
#   1. On remote machine: ollama serve && ollama pull phi4-mini
#   2. On this machine:   ssh -N -L 11434:localhost:11434 <user>@<remote-ip>
#   3. OLLAMA_URL below connects through the tunnel transparently.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=phi4-mini
OLLAMA_TIMEOUT=120

# ── Cloud LLM Fallback: OpenRouter ───────────────────────────
# Used automatically as a fallback if Ollama is unreachable.
# Free models like nvidia/nemotron-3.5-lightning:free or minimax/minimax-m3:free
# are tried in a cascade before falling back to offline regex intent matching.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Other Optional LLM Providers ─────────────────────────────
# OpenAI / Anthropic / Gemini (if using alternative LLM_PROVIDER settings)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Application Settings ─────────────────────────────────────
TALK_TO_PCAP_DATA_DIR=./data
TALK_TO_PCAP_LOG_LEVEL=INFO

# ── Online Enrichment APIs (Optional) ────────────────────────
# All external API results are cached in memory for 24 hours per IP
# to minimize quota usage and latency during live packet capture.

# vpnapi.io (1,000 lookups/day free tier — https://vpnapi.io)
# Returns dedicated VPN, Proxy, Tor, and Relay boolean flags.
VPNAPI_IO_KEY=

# AbuseIPDB (1,000 lookups/day free tier — https://www.abuseipdb.com)
# Returns abuse confidence score and historical reports.
# If omitted, system still checks pre-downloaded offline 100% blacklist.
ABUSEIPDB_API_KEY=

# ipinfo.io (50,000 lookups/month free without token — https://ipinfo.io)
# Privacy flags: vpn, proxy, tor, relay. Works without token; token increases limits.
IPINFO_TOKEN=

# ── Static / Anchor Location (Map Centering & Switch Mode) ────
# Used to center the Leaflet map and anchor private RFC1918 subnets
# when running in switch monitoring mode or offline without public IP.
USER_LAT=25.4279
USER_LON=81.7710
USER_CITY=Prayagraj
USER_COUNTRY=India

# 5G-PacketSense v2 — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Only the variables you need are required.
# Lines starting with # are comments and ignored.

# ── LLM Provider ─────────────────────────────────────────
# Which LLM backend to use for natural-language queries.
# Options: ollama, openai, anthropic, openrouter, gemini
LLM_PROVIDER=ollama

# ── Ollama (local, free) ─────────────────────────────────
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# ── OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Anthropic Claude ──────────────────────────────────────
ANTHROPIC_API_KEY=

# ── OpenRouter (supports multiple models) ─────────────────
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ── Google Gemini ─────────────────────────────────────────
GEMINI_API_KEY=

# ── Offline User Location ────────────────────────────────
# Used in switch mode when internet is unavailable.
# Set to your deployment site's coordinates for accurate map display.
# If not set, location is derived from gateway IP via local GeoLite2 DB.
# USER_LAT=28.6139
# USER_LON=77.2090
# USER_CITY=Delhi
# USER_COUNTRY=India

# ── Application Settings ─────────────────────────────────
TALK_TO_PCAP_DATA_DIR=./data
TALK_TO_PCAP_LOG_LEVEL=INFO

# ── Threat Intelligence ──────────────────────────────────
# Run `python scripts/update_threat_intel.py` before deploying
# in offline/switch mode to download all threat databases.

# ── AbuseIPDB (Optional Online Enrichment) ───────────────
# Get a free API key from https://www.abuseipdb.com/account/api
# Free tier: 1,000 lookups/day. Without this key, the system
# still works 100% offline using pre-downloaded blacklists.
# ABUSEIPDB_API_KEY=your_api_key_here

# ── vpnapi.io (Optional — Recommended for Best VPN Detection) ─
# Provides dedicated VPN/Proxy/Tor/Relay flags per IP.
# Free tier: 1,000 lookups/day — https://vpnapi.io
# VPNAPI_IO_KEY=your_key_here

# ── ipinfo.io (Optional — Free without token) ────────────────
# Privacy flags: vpn, proxy, tor, relay per IP.
# Works without a token (50k/month free). Token increases limits.
# https://ipinfo.io/signup
# IPINFO_TOKEN=your_token_here

# ── ip-api.com (No key required) ─────────────────────────────
# Free proxy/hosting detection — 45 req/min, no registration needed.
# Automatically used when available.
